# Anti-cheat backend (ac.api.sancochat.fun) integration
# API keys the backend uses to send flags: name:key,name2:key2 (keys >= 24 chars, e.g. openssl rand -hex 32)
AC_API_KEYS=
# Discord webhook for flag logs (nickname, short description, hint)
AC_WEBHOOK_FLAGS=
AC_SIGNING_PUBLIC_KEY=
AC_SIGNATURE_TIMEOUT_SECONDS=120
