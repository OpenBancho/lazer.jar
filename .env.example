PORT=8000
LEVEL=DEV
DOMAIN=localhost:8000

DB_HOST=localhost
DB_USER=bancho
DB_PASS=changeme
DB_NAME=bancho
DB_PORT=3306
DB_TIMEZONE=UTC

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

OSU_API_KEY=your_osu_api_key_here
DIRECT_SEARCH=https://osu.direct/api/search

# Anti-cheat backend (ac.api.sancochat.fun) integration
# API keys the backend uses to send flags: name:key,name2:key2 (keys >= 24 chars, e.g. openssl rand -hex 32)
AC_API_KEYS=
# Discord webhook for flag logs (nickname, short description, hint)
AC_WEBHOOK_FLAGS=
AC_SIGNING_PUBLIC_KEY=
AC_SIGNATURE_TIMEOUT_SECONDS=120
# Vouching: staff of this server can vouch for a player the anti-cheat flagged (POST /api/v2/anticheat/vouch).
# AC_URL is the anti-cheat server, AC_SERVER_KEY is this server's key there (an entry of its INTERNAL_API_KEYS). Empty = off.
AC_URL=
AC_SERVER_KEY=

# Which client this server supports: strict (anti-cheat client only, needs AC_SIGNING_PUBLIC_KEY) or nonstrict (no anti-cheat)
CLIENT_MODE=nonstrict

# What to do with a score the anti-cheat server did not confirm: flag (only record) or hide (also remove it from the leaderboards)
AC_UNSIGNED_ACTION=flag
